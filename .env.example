# Copy to .env for local development. Never commit the real .env file.

ENV=development

# Postgres (docker-compose service: postgres)
# Host port 5433 (not the default 5432) — this machine already runs another
# project's Postgres container bound to 5432.
DATABASE_URL=postgresql://vigilo:vigilo-dev-secret@localhost:5433/vigilo

# Redis (docker-compose service: redis)
# Host port 6380 (not the default 6379) — same reason as above.
REDIS_URL=redis://localhost:6380/0

# Object storage — MinIO locally, S3-compatible in production (docker-compose service: minio)
# Host port 9010 (not the default 9000) — same reason as above.
OBJECT_STORE_ENDPOINT=http://localhost:9010
OBJECT_STORE_ACCESS_KEY=vigilo
OBJECT_STORE_SECRET_KEY=vigilo-dev-secret
OBJECT_STORE_BUCKET=vigilo-evidence

# Brand config (single source of truth for user-visible naming)
VIGILO_BRAND_CONFIG_PATH=./brand.config.json

# Clerk (managed auth — apps/api verifies session JWTs against this JWKS)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Self-hosting only — docker-compose.self-host.yml bakes these into
# apps/web's build (see apps/web/.env.example for the equivalent local-dev
# variables when running `npm run dev` directly instead of via Docker).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=vigilo-api

# Postmark (transactional email — free-scan reports, ownership-verification instructions)
POSTMARK_SERVER_TOKEN=
MAIL_FROM_ADDRESS=scans@vigilo.io

# apps/web — apps/scanner's ARQ worker navigates here with Playwright to render a
# scan's report page to PDF ("one layout source of truth", docs/adr's ADR-0002 addendum).
# In production this must be the real https:// WEB_DOMAIN below, exactly —
# apps/api's CORS check is an exact origin-string match.
WEB_APP_URL=http://localhost:3000

# Extra origins allowed to call the API alongside WEB_APP_URL (CORS only,
# comma-separated) — e.g. apps/web served under a second domain pointed at
# the same deployment. Leave unset if there's only ever one origin.
ADDITIONAL_CORS_ORIGINS=

# Self-hosting only, production VPS deployment (docker-compose.self-host.yml's
# `caddy` service, docs/self-hosting.md) — the two public hostnames Caddy
# terminates TLS for. Point both as DNS A records at your VPS's IP first.
# Leave unset for local-only self-hosting; Caddy isn't needed there.
WEB_DOMAIN=
API_DOMAIN=

# Optional — a second domain Caddy also serves the `web` container on
# (Caddyfile's EXTRA_WEB_DOMAIN), e.g. a product subdomain of a parent
# company site pointed at this same deployment. Add its origin to
# ADDITIONAL_CORS_ORIGINS above too, or browser requests from it will be
# blocked by CORS. Leave unset if WEB_DOMAIN is the only domain.
EXTRA_WEB_DOMAIN=

# apps/web's build-time API origin (docker-compose.self-host.yml only —
# baked into the JS bundle at build time, not read at runtime). Must be
# https:// + API_DOMAIN in production; the localhost default only works
# for a single-machine trial.
PUBLIC_API_BASE_URL=http://localhost:8000

# Anthropic (Claude-backed remediation prompts, Phase 5 — optional: scans
# complete and reports render with template-based remediation text if unset,
# per docs/adr/ADR-0004-llm-boundary.md's hard availability requirement)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Paddle (merchant-of-record billing, Phase 7 — optional: every account
# defaults to the Free plan's entitlements with these unset; checkout/
# webhook endpoints raise a clear config error rather than silently no-op,
# since unlike email/LLM there's no safe fallback for "process a payment")
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_BUILDER=
PADDLE_PRICE_ID_STUDIO=
PADDLE_PRICE_ID_BUSINESS=
