# Copy to .env for local development. Never commit the real .env file.

ENV=development

# Postgres (docker-compose service: postgres)
# Host port 5433 (not the default 5432) — this machine already runs another
# project's Postgres container bound to 5432.
DATABASE_URL=postgresql://vigilo:vigilo-dev-secret@localhost:5433/vigilo

# Redis (docker-compose service: redis)
# Host port 6380 (not the default 6379) — same reason as above.
REDIS_URL=redis://localhost:6380/0

# Object storage — MinIO locally, S3-compatible in production (docker-compose service: minio)
# Host port 9010 (not the default 9000) — same reason as above.
OBJECT_STORE_ENDPOINT=http://localhost:9010
OBJECT_STORE_ACCESS_KEY=vigilo
OBJECT_STORE_SECRET_KEY=vigilo-dev-secret
OBJECT_STORE_BUCKET=vigilo-evidence

# Brand config (single source of truth for user-visible naming)
VIGILO_BRAND_CONFIG_PATH=./brand.config.json
